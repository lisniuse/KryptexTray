# Copy this file to .env and fill in KRYPTEX_COOKIE.
#
# How to get the cookie (Chrome):
#   1. Open https://www.kryptex.com/site/dashboard and make sure you are logged in.
#   2. Press F12, switch to the Network tab, then reload the page.
#   3. Click the first "dashboard" request -> Headers -> Request Headers.
#   4. Copy the whole value after "Cookie:" and paste it below.
#
# The same cookie is used for both /site/dashboard (balance) and /site/hardware (workers).
# This cookie is a login credential. .env is excluded by .gitignore; do not commit or share it.
# When it expires, paste a fresh value; the app reloads .env before every refresh.

KRYPTEX_COOKIE=replace_me_with_your_cookie
KRYPTEX_URL=https://www.kryptex.com/site/dashboard
REFRESH_SECONDS=60
